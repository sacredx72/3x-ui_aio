###############################################################################
#  LucX-UI All-in-One Installer v7.2-FINAL — файл конфигурации (aio.env)
#  -----------------------------------------------------------------------------
#  Как использовать:
#    1) отредактируйте значения ниже
#    2) запустите: sudo bash lucx-ui-aio-final.sh
#       (файл aio.env рядом со скриптом подхватится сам)
#       либо укажите путь явно: sudo bash lucx-ui-aio-final.sh --env /root/aio.env
#
#  Формат:   ПЕРЕМЕННАЯ = "значение"
#    • значение пустое ("") — скрипт сгенерирует значение сам (порт/креды)
#      или запросит ввод (домены)
#    • значение указано     — будет использовано на ВСЕХ этапах установки
#                             (панель, xray, nginx, ufw, отчёт и креды)
#    • пробелы вокруг «=» и кавычки — допускаются
#    • inline-комментарий:  ... "значение" # комментарий
#    • CLI-аргументы ( -d, -r, ... ) имеют приоритет над этим файлом
###############################################################################

# ------------------------------------------------------------------------------
# ОСНОВНЫЕ ДОМЕНЫ (нужны A-записи на IP сервера)
# ------------------------------------------------------------------------------

# Домен панели и всех прокси-протоколов за nginx (нужен SSL-сертификат,
# выпускается автоматически). Обязательный.
DOMAIN = "pan.example.com"

# Домен для VLESS-REALITY (основной REALITY-инбаунд, с Vision — flow задаётся
# на клиенте). Должен отличаться от DOMAIN. Нужна только A-запись
# (TLS-сертификат не требуется — REALITY терминирует TLS сам). Обязательный.
REALITY_DOMAIN = "rial.example.com"

# ------------------------------------------------------------------------------
# ОПЦИОНАЛЬНЫЕ ДОМЕНЫ (пусто — протокол пропускается / живёт на прямом порту)
# ------------------------------------------------------------------------------

# Домен Telegram WEB proxy (tproxy-server + MTProxy + Caddy TLS за nginx 443).
# Нужна A-запись + SSL-сертификат. Если пусто — tproxy не устанавливается.
TG_WEB_DOMAIN = "tg.example.com"
# Домен для VLESS+XHTTP+REALITY за 443 (nginx stream по SNI > xray).
# Нужна ТОЛЬКО A-запись (сертификат не требуется). Если пусто — инбаунд
# слушает прямой порт (см. VLESS_XHTTP_R_PORT ниже).
XHTTP_R_DOMAIN = "xh.example.com"
# Домен для VLESS+gRPC+REALITY за 443 (nginx stream по SNI > xray).
# Нужна ТОЛЬКО A-запись. Если пусто — прямой порт (VLESS_GRPC_R_PORT).
GRPC_R_DOMAIN = "gr.example.com"
# Домен для TrustTunnel за 443 (nginx stream по SNI > trusttunnel).
# Нужна A-запись + SSL-сертификат. ВАЖНО: клиенты TrustTunnel подключаются
# ТОЛЬКО к порту 443, поэтому для полной работоспособности рекомендуется
# задать этот домен. Если пусто — прямой порт (TRUSTTUNNEL_PORT).
TT_DOMAIN = "tt.example.com"

# ------------------------------------------------------------------------------
# УЧЁТНЫЕ ДАННЫЕ ПАНЕЛИ (пусто — сгенерируются случайно и будут показаны
# в конце установки / сохранены в /etc/x-ui/install-result.env и
# /root/lucx-ui-credentials.txt)
# ------------------------------------------------------------------------------

# Логин администратора панели (пусто — авто)
PANEL_USER = ""
# Пароль администратора панели (пусто — авто)
PANEL_PASS = ""

# ------------------------------------------------------------------------------
# ФИКСИРОВАННЫЕ ПОРТЫ (NEW v7.2)
# ------------------------------------------------------------------------------
# Любой порт ниже можно задать ПРИНУДИТЕЛЬНО. Если переменная НЕ пустая —
# этот порт используется на всех этапах (панель/xray/nginx/ufw/креды).
# Пустые переменные ("") — порт генерируется скриптом автоматически.
# Диапазон авто-генерации: 10000-59151. Порт 22/80/443 не использовать,
# кроме HY2_PORT (443/udp) — за ним закреплён Hysteria2.

# Веб-интерфейс панели LucX-UI (не 80/443 — их занимают nginx/REALITY)
PANEL_PORT = ""
# Сервер подписок (sub/json/clash/awg) — за nginx 443
SUB_PORT = ""
# Внутренние порты XRAY за nginx (слушают 127.0.0.1):
VLESS_WS_PORT = ""        # VLESS WebSocket
VLESS_GRPC_PORT = ""      # VLESS gRPC
TROJAN_GRPC_PORT = ""     # Trojan gRPC
VMESS_WS_PORT = ""        # VMess WebSocket
VLESS_XHTTP_R_PORT = ""   # VLESS XHTTP REALITY (прямой порт, если нет -x)
VLESS_GRPC_R_PORT = ""    # VLESS gRPC REALITY (прямой порт, если нет -g)
VLESS_HU_PORT = ""        # VLESS HTTPUpgrade
# Hysteria2 — свой UDP-порт (по умолчанию 443/udp; менять не обязательно)
HY2_PORT = ""
# Sidecar-протоколы (прямые порты):
NAIVE_PORT = ""           # NaiveProxy (caddy, свой TLS)
OLCRTC_PORT = "19448"          # olcRTC (tcp)
QWDTT_PORT = "19447"           # qWDTT (udp/DTLS)
MIERU_PORT = "19446"           # mieru (tcp)
TRUSTTUNNEL_PORT = ""     # TrustTunnel (tcp; клиенты TT ходят на 443 при -u)
ANYTLS_PORT = "19445"          # AnyTLS (tcp, TLS)
TG_PORT = "19443"              # Telegram MTProto (tcp)
TPROXY_PORT = "4443"          # Telegram WEB proxy (caddy TLS, за nginx SNI)
# Диагностический порт (метрики/внутренний)
MTR_PORT = ""
# AWG kernel × 9 + AmneziaWG (UDP; дефолты 53201–53210)
AWG15_PORT = "53221"
AWG20_PORT = "53222"
AWG31_PORT = "53223"
AWG1_PORT = "53201"
AWG2_PORT = "53202"
AWG3_PORT = "53203"
AWG4_PORT = "53204"
AWG5_PORT = "53205"
AWG6_PORT = "53206"
AWG7_PORT = "53207"
AWG8_PORT = "53208"
AWG9_PORT = "53209"
AMNEZIAWG_PORT = "53210"

# AdGuard Home (NEW v7.3):
#   INSTALL_ADGUARD = "1" — установить (по умолчанию; пусто = установить),
#   INSTALL_ADGUARD = "0" — НЕ устанавливать.
# Web-UI и plain-DNS слушают только 127.0.0.1; наружу — через nginx домена
# панели:  /dns-query (DoH для клиентов) и /adg-<случайный>/ (админка).
INSTALL_ADGUARD = ""
# Порты AdGuard Home (loopback; пусто — случайные свободные):
AGH_WEB_PORT = ""
AGH_DNS_PORT = ""
# Устарело: web-UI AGH не слушает свой HTTPS (port_https=0, TLS у nginx).
# Можно оставить пустым / не задавать.
AGH_WEB_TLS_PORT = ""
# Внутренний DoT-порт AGH на loopback (пусто — случайный; снаружи всегда 853):
AGH_DOT_PORT = ""
# Логин/пароль админки AdGuard Home (пусто — admin / случайный пароль):
AGH_USER = ""
AGH_PASS = ""

# ------------------------------------------------------------------------------
# ПОДСЕТИ AWG (NEW v7.2)
# ------------------------------------------------------------------------------
# Формат: a.b.c.1/24 — адрес СЕРВЕРА (gateway туннеля, последний октет .1).
# Клиент получает <подсеть>.2/32 автоматически. Пусто — дефолтный шаблон:
# 10.221.0.1/24, 10.222.0.1/24, 10.223.0.1/24.
AWG1_SUBNET = "10.201.0.1/24"
AWG2_SUBNET = "10.202.0.1/24"
AWG3_SUBNET = "10.203.0.1/24"
AWG4_SUBNET = "10.204.0.1/24"
AWG5_SUBNET = "10.205.0.1/24"
AWG6_SUBNET = "10.206.0.1/24"
AWG7_SUBNET = "10.207.0.1/24"
AWG8_SUBNET = "10.208.0.1/24"
AWG9_SUBNET = "10.209.0.1/24"
AMNEZIAWG_SUBNET = "10.210.0.1/24"
AWG15_SUBNET = "10.221.0.1/24"
AWG20_SUBNET = "10.222.0.1/24"
AWG31_SUBNET = "10.223.0.1/24"

# ------------------------------------------------------------------------------
# ПОВЕДЕНИЕ УСТАНОВКИ
# ------------------------------------------------------------------------------

# Очистка предыдущих установок (старые x-ui/nginx-конфиги/sidecar-процессы
# удаляются или переносятся в *.old.* перед установкой) — исключает
# конфликты портов/конфигов. По умолчанию: "n" (очистка ВЫПОЛНЯЕТСЯ).
# Укажите "y", чтобы ОТКЛЮЧИТЬ очистку:
SKIP_CLEANUP = ""

# Пропустить установку системных пакетов через apt (если уже установлены):
SKIP_PKG = ""